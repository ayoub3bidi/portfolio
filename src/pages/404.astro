---
import MainGridLayout from '../layouts/MainGridLayout.astro'
import { url } from '../utils/url-utils'

const homeURL = url('/')
---

<MainGridLayout title="Page not found" description="The page you are looking for does not exist.">
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-16 relative w-full flex flex-col items-center text-center onload-animation">
            <div class="font-bold text-[5rem] leading-none text-black/10 dark:text-white/10 select-none">
                404
            </div>
            <h1 class="text-2xl md:text-3xl font-bold mt-4 text-black/90 dark:text-white/90">
                Page not found
            </h1>
            <p class="mt-3 text-black/50 dark:text-white/50 max-w-md">
                The page you are looking for doesn't exist or has been moved.
            </p>
            <a
                href={homeURL}
                class="mt-8 rounded-lg bg-[var(--primary)] px-6 py-2.5 font-medium text-white transition hover:opacity-90 active:scale-95"
            >
                Back to Home
            </a>
        </div>
    </div>
</MainGridLayout>
