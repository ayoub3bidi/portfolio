---
import type { SiteConfig } from '../../types/config'
import ImageWrapper from './ImageWrapper.astro'

interface Props {
  banner: SiteConfig['banner']
  class?: string
}

const { banner, class: className } = Astro.props

const isYoutube =
  banner.media === 'youtube' &&
  typeof banner.youtubeVideoId === 'string' &&
  banner.youtubeVideoId.length > 0

const ytId = isYoutube ? banner.youtubeVideoId : ''
---

{
  isYoutube ? (
    <div
      id="banner"
      data-youtube-id={ytId}
      class:list={[className, 'overflow-hidden relative isolate']}
    >
      {/*
        Video stays painted (not visibility:hidden) so YouTube can auto-dismiss
        its chrome. The opaque poster above is what the user sees until settle.
      */}
      <div
        class="banner-video-layer absolute inset-0 z-0 motion-reduce:hidden"
        aria-hidden="true"
      >
        <div class="banner-youtube-iframe">
          <div id="banner-yt-player" />
        </div>
      </div>
      <div
        id="banner-static-fallback"
        class="banner-static-fallback pointer-events-none absolute inset-0 z-[1] bg-black motion-reduce:opacity-100"
      >
        <ImageWrapper
          src={banner.src}
          position={banner.position}
          alt=""
          class="h-full w-full"
        />
      </div>
      <div class="pointer-events-none absolute inset-0 z-[2] bg-black/20 transition dark:bg-black/30" />
    </div>
  ) : (
    <ImageWrapper
      id="banner"
      alt="Banner image of the blog"
      class:list={[className]}
      src={banner.src}
      position={banner.position}
    />
  )
}

<style>
  .banner-video-layer {
    overflow: hidden;
    pointer-events: none;
  }
  /*
    Cover-crop + overscale so residual top/bottom chrome stays clipped
    even if YouTube paints it after we lift the poster.
  */
  .banner-youtube-iframe {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100vw;
    height: 56.25vw;
    min-width: 177.78vh;
    min-height: 100vh;
    transform: translate(-50%, -50%) scale(1.5);
  }
  #banner-yt-player,
  .banner-youtube-iframe :global(iframe) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
    pointer-events: none;
  }
  .banner-static-fallback {
    opacity: 1;
    transition: none;
  }
  #banner.banner-yt-ready .banner-static-fallback {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  #banner.banner-yt-failed .banner-static-fallback {
    opacity: 1;
    visibility: visible;
  }
  #banner.banner-yt-failed .banner-video-layer {
    display: none;
  }
</style>

{
  isYoutube && (
    <script is:inline define:vars={{ ytId }}>
      ;(function () {
        const READY_TIMEOUT_MS = 20000
        const YT_PLAYING = 1
        /*
          Player must stay painted under the poster (not visibility:hidden),
          otherwise YouTube never auto-hides chrome and it flashes on uncover.
          Wait this long after PLAYING, then lift the poster.
        */
        const CHROME_SETTLE_MS = 4000

        function initBannerYoutube() {
          const banner = document.getElementById('banner')
          if (!banner || banner.dataset.youtubeId !== ytId) return
          if (banner.dataset.ytBannerInit === '1') return
          if (!document.getElementById('banner-yt-player')) return

          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            return
          }

          banner.dataset.ytBannerInit = '1'
          banner.classList.remove('banner-yt-ready', 'banner-yt-failed')

          let ready = false
          let settleTimer = 0
          const failSafe = window.setTimeout(function () {
            if (!ready) {
              banner.classList.add('banner-yt-failed')
            }
          }, READY_TIMEOUT_MS)

          function clearFailSafe() {
            window.clearTimeout(failSafe)
          }

          function bannerStillHidden() {
            return banner.classList.contains('opacity-0')
          }

          function markReady() {
            if (ready) return
            if (bannerStillHidden()) {
              settleTimer = window.setTimeout(markReady, 100)
              return
            }
            ready = true
            clearFailSafe()
            if (settleTimer) window.clearTimeout(settleTimer)
            settleTimer = 0
            banner.classList.add('banner-yt-ready')
          }

          function markFailed() {
            clearFailSafe()
            if (settleTimer) window.clearTimeout(settleTimer)
            settleTimer = 0
            banner.classList.remove('banner-yt-ready')
            banner.classList.add('banner-yt-failed')
          }

          function scheduleReveal() {
            if (ready) return
            if (settleTimer) window.clearTimeout(settleTimer)

            // Settle clock must run while the player is actually painted under
            // the poster. If #banner is still opacity-0, wait for showBanner first.
            function startSettleWhenVisible() {
              if (ready) return
              if (bannerStillHidden()) {
                settleTimer = window.setTimeout(startSettleWhenVisible, 100)
                return
              }
              settleTimer = window.setTimeout(markReady, CHROME_SETTLE_MS)
            }

            startSettleWhenVisible()
          }

          function createPlayer() {
            try {
              const _bannerYt = new YT.Player('banner-yt-player', {
                videoId: ytId,
                width: '100%',
                height: '100%',
                host: 'https://www.youtube-nocookie.com',
                playerVars: {
                  autoplay: 1,
                  mute: 1,
                  loop: 1,
                  playlist: ytId,
                  controls: 0,
                  disablekb: 1,
                  fs: 0,
                  iv_load_policy: 3,
                  cc_load_policy: 0,
                  modestbranding: 1,
                  playsinline: 1,
                  rel: 0,
                  showinfo: 0,
                },
                events: {
                  onReady: function (event) {
                    try {
                      event.target.mute()
                      event.target.playVideo()
                    } catch {
                      /* ignore */
                    }
                  },
                  onStateChange: function (event) {
                    if (event.data === YT_PLAYING) {
                      scheduleReveal()
                    }
                  },
                  onError: function () {
                    markFailed()
                  },
                },
              })
              void _bannerYt
            } catch {
              markFailed()
            }
          }

          if (window.YT && window.YT.Player) {
            createPlayer()
            return
          }

          const previous = window.onYouTubeIframeAPIReady
          window.onYouTubeIframeAPIReady = function () {
            if (typeof previous === 'function') {
              previous()
            }
            createPlayer()
          }

          if (!document.querySelector('script[src="https://www.youtube.com/iframe_api"]')) {
            const tag = document.createElement('script')
            tag.src = 'https://www.youtube.com/iframe_api'
            tag.async = true
            document.head.appendChild(tag)
          }
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initBannerYoutube)
        } else {
          initBannerYoutube()
        }

        document.addEventListener('astro:after-swap', initBannerYoutube)
      })()
    </script>
  )
}
