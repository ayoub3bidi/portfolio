{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ayoub3bidi-portfolio",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}